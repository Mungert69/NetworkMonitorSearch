<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);docker-context/**</DefaultItemExcludes>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>

    <!-- Build & containerize for BOTH arches -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>

    <ContainerImageTag>0.8.0</ContainerImageTag>
    <ContainerImageFormat>OCI</ContainerImageFormat>

    <RollForward>Minor</RollForward>
    <StartupObject>NetworkMonitor.Search.Program</StartupObject>
    <Nullable>enable</Nullable>
    <NoWarn>CS8618</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release-Dev'">
    <DefineConstants>DEV</DefineConstants>
    <Optimize>true</Optimize>
    <ContainerRepository>mungert/networkmonitorsearch-dev</ContainerRepository>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <ContainerRepository>mungert/networkmonitorsearch</ContainerRepository>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' AND '$(_IsPublishing)'=='true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release-Dev' AND '$(_IsPublishing)'=='true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="NEST" Version="7.17.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenSearch.Client" Version="2.3.0" />
    <PackageReference Include="HostInitActions" Version="1.3.1" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <!-- Linux-only native runtimes for both arches -->
    <PackageReference Include="Tokenizers.DotNet.runtime.linux-x64" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.linux-arm64" Version="1.4.1" />
    <!-- Remove the Windows-specific runtime to avoid pulling win assets into Linux images -->
    <!-- <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.3.0" /> -->

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorLib\NetworkMonitor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetworkMonitorData\NetworkMonitorData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="stsb-bert-tiny-onnx\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="qwen3-embed-0.6-onnx\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <!-- Match SDK-published containers to the local ASP.NET Core runtime. -->
  <Target Name="SelectLocalContainerRuntime" BeforeTargets="ComputeContainerBaseImage">
    <Exec Command="dotnet --list-runtimes | awk '$1 == &quot;Microsoft.AspNetCore.App&quot; { print $2 }' | sort -V | tail -n1"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="LocalAspNetVersion" />
    </Exec>
    <Error Condition="'$(LocalAspNetVersion)' == ''" Text="No local ASP.NET Core runtime found by dotnet --list-runtimes." />
    <PropertyGroup>
      <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:$(LocalAspNetVersion)</ContainerBaseImage>
    </PropertyGroup>
  </Target>

</Project>
