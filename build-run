#!/bin/sh
set -eu

CONFIG="Release"

# Pull updates if you really need to (avoid embedding secrets in CLI when possible)
# value=$(cat ../secret)
# git pull "https://mungert69:$value@github.com/Mungert69/NetworkMonitorSearch"

# Read tag from csproj
TAG="$(sed -n 's/.*<ContainerImageTag>\(.*\)<\/ContainerImageTag>.*/\1/p' NetworkMonitorSearch.csproj | head -n1)"
[ -n "${TAG:-}" ] || TAG="latest"

# Read repo from matching PropertyGroup
REPO="$(
  awk -v cfg="$CONFIG" '
    $0 ~ "<PropertyGroup" && $0 ~ "Condition=" && $0 ~ "\\x27\\$\\(Configuration\\)\\x27[[:space:]]*==[[:space:]]*\\x27" cfg "\\x27" { inpg=1; next }
    inpg && /<ContainerRepository>/ {
      line=$0
      sub(/.*<ContainerRepository>/, "", line)
      sub(/<\/ContainerRepository>.*/, "", line)
      print line
      exit
    }
    inpg && /<\/PropertyGroup>/ { inpg=0 }
  ' NetworkMonitorSearch.csproj
)"
[ -n "${REPO:-}" ] || REPO="mungert/networkmonitorsearch"

echo "Publishing multi-arch container: $REPO:$TAG ($CONFIG)"

# Optional tests (add specific test projects if you have them)
dotnet test --nologo || true

dotnet publish NetworkMonitorSearch.csproj \
  -c "$CONFIG" \
  -t:PublishContainer

