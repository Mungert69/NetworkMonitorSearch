# syntax=docker/dockerfile:1.6

ARG ASPNET_VERSION=10.0.11
FROM mcr.microsoft.com/dotnet/aspnet:${ASPNET_VERSION}

ARG TARGETARCH
WORKDIR /app
COPY layers/${TARGETARCH}/native/ ./
COPY layers/${TARGETARCH}/dependencies/ ./
COPY layers/${TARGETARCH}/networkmonitor/ ./
COPY layers/${TARGETARCH}/networkmonitordata/ ./
COPY layers/${TARGETARCH}/content/ ./
COPY layers/${TARGETARCH}/application/ ./
USER 1654
ENTRYPOINT ["dotnet", "NetworkMonitorSearch.dll"]
